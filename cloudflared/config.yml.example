# Add these rules BEFORE the existing Mosquitto catch-all for this hostname.
# Replace 192.168.x.x with the broker LXC IP. Keep the catch-all so existing
# ESP/SAP DM clients using wss://mqtt.example.com continue to connect.
#
#   - hostname: mqtt.example.com
#     path: ^/(dashboard|editor|shopfloor|config-editor|previews|assets|mqtt)(/.*)?$
#     service: http://192.168.x.x:80
#
#   - hostname: mqtt.example.com
#     service: ws://192.168.x.x:9001
#
# Open /dashboard/ directly. The root path remains the legacy MQTT endpoint.
# Restart the existing cloudflared service after updating its ingress rules.
