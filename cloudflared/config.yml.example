# Route this hostname to Nginx for both browser pages and MQTT WebSockets.
# Replace 192.168.x.x with the broker LXC IP. Install the updated Nginx
# configuration before replacing older path-specific / port 9001 rules.
#
#   - hostname: mqtt.example.com
#     service: http://192.168.x.x:80
#
# https://mqtt.example.com redirects to /dashboard/.
# wss://mqtt.example.com and wss://mqtt.example.com/mqtt both proxy to Mosquitto.
# Restart the existing cloudflared service after updating its ingress rules.
