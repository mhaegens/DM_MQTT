# Cloudflare Tunnel configuration template
# Copy this file to config.yml and fill in your values.
# Do NOT commit config.yml — it contains your tunnel ID.
#
# Steps:
#   1. Create a tunnel in Cloudflare Zero Trust > Networks > Tunnels
#   2. Copy the tunnel credentials JSON to this directory
#   3. cp config.yml.example config.yml
#   4. Replace <your-tunnel-id> and mqtt.yourdomain.com below
#   5. docker compose restart cloudflared

tunnel: <your-tunnel-id>
credentials-file: /etc/cloudflared/<your-tunnel-id>.json

ingress:
  - hostname: mqtt.yourdomain.com
    service: ws://mosquitto:9001
  - service: http_status:404
