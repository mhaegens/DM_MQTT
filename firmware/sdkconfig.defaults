# ─── PSRAM ───────────────────────────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Allow PSRAM for large LVGL draw buffers and metric history arrays
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ─── LVGL ────────────────────────────────────────────────────────────────────
# Double-buffered rendering; buffers allocated in PSRAM by ui_main.c
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_USE_STDLIB_MALLOC=y
CONFIG_LV_STDLIB_MALLOC_INCLUDE="freertos/FreeRTOS.h"

# ─── FreeRTOS ────────────────────────────────────────────────────────────────
# UI task on Core 0, MQTT + NFC tasks on Core 1
CONFIG_FREERTOS_UNICORE=n
# Increase main stack for LVGL draw callbacks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ─── Networking ──────────────────────────────────────────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
# WebSocket MQTT needs larger TCP buffers
CONFIG_MQTT_BUFFER_SIZE=4096
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=30000

# ─── TLS / MQTT over WSS ─────────────────────────────────────────────────────
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y   # Cloudflare cert; set to n with proper CA bundle in production
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# ─── Flash / Partition ───────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ─── Logging ─────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
