CONFIG_IDF_TARGET="esp32p4"

# Compiler — -O2. Without this IDF defaults to Debug (-Og) and the LVGL
# software renderer (the hottest code on the device) runs unoptimised.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Waveshare 4B is documented at 360 MHz. Do not assume later 400 MHz silicon.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# PSRAM — heap only (XIP removed: it triggers linker non-contiguous-regions issue)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Prefer PSRAM for ordinary objects/buffers above 64 bytes. The previous
# 512-byte cutoff crowded internal RAM with UI allocations and prevented
# the phone portal's internal-stack task from starting alongside WSS.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=81920

# Large TLS buffers follow the PSRAM-aware malloc policy. Keeping every TLS
# allocation internal starved SD DMA during a handshake with the full UI and
# phone portal active. Task stacks and explicit DMA allocations stay internal.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# L2 cache — required for DPI DMA to stream from PSRAM framebuffer fast enough
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Bootloader
CONFIG_BOOTLOADER_WDT_TIME_MS=30000

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# FATFS — long filename support. The ESP-IDF default is DOS 8.3 names only, so
# every fopen() of "sapdm_config.json" (12-char basename) on the SD card failed
# with FR_INVALID_NAME: reads fell back to the embedded default silently, and
# the portal's config upload reported "Cannot write to SD card".
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# LVGL (from working reference 10_lvgl_demo_v9)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2

# Touch sampling — LVGL's default indev read period is 30 ms, so a scroll
# gesture only produces new positions at 33 Hz even when frames render at 60.
# 10 ms sampling makes the scroll position track the finger.
# Sampling configured through lv_indev_get_read_timer() in main.c; LVGL 9.5
# has no LV_INDEV_DEF_READ_PERIOD Kconfig symbol.

# Software shadow cache — the NFC badge cards (shadow 20 + radius 16) and the
# detail-view cards re-blur their box shadows on every repaint without this.
# 40 covers the largest shadow_width+radius in the UI; cache is a few KB.
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=40

# Montserrat fallback fonts (built into LVGL)
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# Console — UART0 (Waveshare ESP32-P4 uses external CH343 USB-UART bridge on UART0)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Newlib — LF-only stdout so binary pixel data is not corrupted by CRLF translation
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y

# LVGL snapshot API (used by screenshot tool)
CONFIG_LV_USE_SNAPSHOT=y

# LVGL QR code widget (used by WiFi setup screen)
CONFIG_LV_USE_QRCODE=y

# WiFi via ESP32-C6 companion chip over SDIO (Waveshare ESP32-P4 WiFi6 board)
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=18
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y

# MQTT — pin internal task to CPU0 so it cannot starve LVGL on CPU1
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_POLL_READ_TIMEOUT_MS=25

# Display — double framebuffer + avoid-tearing eliminates partial-render cyan flashes.
# DIRECT mode (was FULL_REFRESH): LVGL renders only dirty regions straight into the
# active framebuffer; the swap still happens on vsync so tearing/cyan stay fixed, but a
# small label update no longer costs a full 720x720 repaint (~1 MB) like full-refresh did.
# The mode switch itself is carried by patches/esp_lvgl_port_avoid_tearing_direct_mode.patch
# (the Waveshare BSP does not set direct/full flags on the LVGL port in its avoid-tear
# path). DIRECT_MODE below is set for BSPs that expose the Kconfig choice; it is ignored
# if the symbol does not exist.
# Each framebuffer is 720x720x2 = ~1 MB; both live in PSRAM via DPI DMA + L2 cache.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
