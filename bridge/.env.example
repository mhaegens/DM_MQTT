# SAP DM service key credentials
# Get these from BTP cockpit: Instances & Subscriptions -> DM service instance -> Service Keys
DM_CLIENT_ID=
DM_CLIENT_SECRET=
DM_TOKEN_URL=https://<btp-subaccount>.authentication.<region>.hana.ondemand.com/oauth/token
DM_API_HOST=api.<region-host>

# SAP DM plant ID
DM_PLANT=1710

# MQTT broker URL (inside Docker Compose network; override for local dev)
MQTT_BROKER_URL=mqtt://mosquitto:1883

# System user ID for timetracking calls (must exist as a user in the DM tenant)
BRIDGE_USER_ID=BRIDGE_SYS
